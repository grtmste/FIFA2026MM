# Supabase project URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (Project Settings -> API)
# Used ONLY on the server (admin actions) to write data. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password required to access the /admin area
ADMIN_PASSWORD=choose-a-strong-password
